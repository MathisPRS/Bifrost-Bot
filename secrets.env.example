# ============================================================================
#  SECRETS — bot Discord "Valheim / Proxmox"
#  Copier en `secrets.env`, remplir, chmod 600. JAMAIS dans git.
#  A copier sur le NAS (qui heberge le bot), pas sur le Proxmox.
#
#  Attention au quoting : les local keys contiennent des caracteres speciaux.
#  Regle appliquee ici : guillemets simples par defaut, guillemets doubles
#  quand la cle contient elle-meme une apostrophe.
# ============================================================================

# --- Tuya Cloud (portail iot.tuya.com) -------------------------------------
# Projet "Smart Home", data center Central Europe. Acces verifie le 2026-09-15.
TUYA_ACCESS_ID=''
TUYA_ACCESS_SECRET=''
TUYA_REGION=''

# --- Prise alimentant le PROXMOX -------------------------------------------
# "Smart Petit Serveur" — identifiee et testee en local le 2026-09-15.
# /!\ A cette date elle alimente TOUTE la multiprise, NAS compris.
#     Le bot ne doit PAS la couper tant que le NAS n'est pas separe.
TUYA_PLUG_IP=''
TUYA_PLUG_ID=''
TUYA_PLUG_LOCAL_KEY=''
TUYA_PLUG_VERSION=''

# --- Prise alimentant le NAS (a deployer) ----------------------------------
# Le bot ne doit JAMAIS commander cette prise : il tourne dessus.
# Renseignee ici uniquement pour le suivi de consommation.
TUYA_NAS_PLUG_IP=''
TUYA_NAS_PLUG_ID=''
TUYA_NAS_PLUG_LOCAL_KEY=''
TUYA_NAS_PLUG_VERSION=''

# --- Proxmox ----------------------------------------------------------------
PROXMOX_HOST=''
PROXMOX_USER=''
# Token API dedie — role BifrostCtl (VM.Audit VM.PowerMgmt Sys.Audit Sys.PowerMgmt)
PROXMOX_TOKEN_ID=''
PROXMOX_TOKEN_SECRET=''
PROXMOX_VERIFY_SSL=''
PROXMOX_MAC=''
PROXMOX_VMID_DOCKER=''
PROXMOX_VMID_HAOS=''
PROXMOX_VMID_MACOS=''

# --- Discord ----------------------------------------------------------------
# A completer : https://discord.com/developers/applications
DISCORD_BOT_TOKEN=''
DISCORD_GUILD_ID=''
DISCORD_CHANNEL_ID=''
DISCORD_ALLOWED_ROLE=''
# Role habilite a executer /allowrole. Hors base a dessein : s'il etait lui-meme
# modifiable par la commande, un mauvais appel verrouillerait tout le monde dehors.
DISCORD_ADMIN_ROLE=''

# --- Valheim ----------------------------------------------------------------
VALHEIM_CONTAINER=''
VALHEIM_WORLD=''
VALHEIM_PORT=''
